//----------------------------------------------------------------
// テキストの情報系とランダム選択を差し替える
// 引数：　テキスト
// 返値：　ハッシュ（'text'＝差し替え後のテキスト、'choice'＝ランダム選択結果の配列）
//         1.x系は { テキスト, 選択結果の配列 } の配列を返していた
//----------------------------------------------------------------
TransformTextExpand
{
	// システム情報などを取得して差し替え
	_result_text = ReplaceSystemInfo(_argv[0])

	// ランダム選択を決定して差し替え
	ReplaceRandomChoice(_result_text)
}

//----------------------------------------------------------------
// ランダム単語を決定して差し替え
// 引数：　テキスト
// 返値：　ハッシュ（'text'＝差し替え後のテキスト、'choice'＝ランダム選択結果の配列）
//----------------------------------------------------------------
ReplaceRandomChoice
{
	_result_text = _argv[0]
	_result_choice = IARRAY

	for _i = 0 ; _i < 100 ; _i++ {
		if !RE_SEARCH(_result_text, '^(.*?):choice_start:(.+?):choice_end:') {
			break
		}
		_found = RE_GETSTR()
		_words = SPLIT(_found[2], ':')
		_result = ANY(_words)
		_result_choice ,= _result
		_result_text = _found[1] + _result + SUBSTR(_result_text, STRLEN(_found[0]), STRLEN(_result_text))
	}

	_r = IHASH()
	_r['text'] = _result_text
	_r['choice'] = _result_choice
	_r
}

//----------------------------------------------------------------
// システム情報などを取得して差し替え　GetSystemInfoを内包する
// 引数：　テキスト
// 返値：　差し替え後のテキスト
//----------------------------------------------------------------
ReplaceSystemInfo
{
	_text = _argv[0]
	_info = GetSystemInfo()
	foreach ('year', 'month', 'day', 'weekday', 'hour', 'minute', 'second', 'ampm', 'hour12', 'systemuptime', 'systemupsecond', 'systemupminute', 'systemuphour', 'memoryload', 'memorytotalphys', 'memoryavailphys', 'memorytotalvirtual', 'memoryavailvirtual') ; _key {
		if STRSTR(_text, ':' + _key + ':', 0) >= 0 {
			_text = REPLACE(_text, ':' + _key + ':', TOSTR(_info[_key]))
		}
	}
	_text
}

//----------------------------------------------------------------
// システム情報などを取得
// 引数：　なし
// 返値：　ハッシュ
// ※1.0.5までは :ampm: が常に「午前」になっていた（時刻ではなく文字列を比べていた）
//----------------------------------------------------------------
GetSystemInfo
{
	_systemuptime = GETTICKCOUNT() / 1000
	_systemuphour = _systemuptime / 3600
	_systemupminute = (_systemuptime - _systemuphour * 3600) / 60
	_systemupsecond = _systemuptime % 60

	_memory = GETMEMINFO()
	_time = UGM.GetTime

	_ampm = '午前'
	if TOINT(_time['時']) >= 12 {
		_ampm = '午後'
	}

	_hour12 = _time['時'] % 12

	_result = IHASH()
	_result['year'] = _time['年']
	_result['month'] = _time['月']
	_result['day'] = _time['日']
	_result['weekday'] = _time['週']
	_result['hour'] = _time['時']
	_result['minute'] = _time['分']
	_result['second'] = _time['秒']
	_result['ampm'] = _ampm
	_result['hour12'] = _hour12
	_result['systemuptime'] = _systemuptime
	_result['systemupsecond'] = _systemupsecond
	_result['systemupminute'] = _systemupminute
	_result['systemuphour'] = _systemuphour
	_result['memoryload'] = _memory[0]
	_result['memorytotalphys'] = _memory[1]
	_result['memoryavailphys'] = _memory[2]
	_result['memorytotalvirtual'] = _memory[3]
	_result['memoryavailvirtual'] = _memory[4]
	_result
}
