//================================================================
// 独自記法を実際の状態にする（1.x系の dict/textexpand.azr を移植）
//================================================================

//----------------------------------------------------------------
// ログ用のテキストを生成する
// 引数：　テキスト, ゴースト名
// 返値：　差し替え後のテキストの段落ごとの配列
//----------------------------------------------------------------
GenerateReceivedLogText
{
	_result_text = REPLACE(_argv[0], ':nl:', '<br>')
	_sender = _argv[1]

	for _i = 0 ; _i < 100 ; _i++ {
		// 代替テキスト無しの画像添付を探す
		if !RE_SEARCH(_result_text, ':image:([^:]+?\.\w+):(?!alt=.*:)') {
			break
		}
		_found = RE_GETSTR()[0]
		_result_text = REPLACE(_result_text, _found, GenerateHtmlImgTag(_found, _sender))
	}

	for _i = 0 ; _i < 100 ; _i++ {
		// 代替テキスト付きの画像添付を探す
		if !RE_SEARCH(_result_text, ':image:([^:]+?\.\w+):alt=([^:]*?):') {
			break
		}
		_found = RE_GETSTR()[0]
		_result_text = REPLACE(_result_text, _found, GenerateHtmlImgTag(_found, _sender))
	}

	for _i = 0 ; _i < 100 ; _i++ {
		// 内蔵スタンプを探す
		if !RE_SEARCH(_result_text, ':stamp(\d+):') {
			break
		}
		_found = RE_GETSTR()
		_number = _found[1]
		_alt = StampAltText()[TOINT(_number)]
		_html = '<img class="stamp"'
		if _alt != '' {
			_html += ' alt="' + _alt + '"'
		}
		_html += ' src="./res/stamp/manpu' + _number + '.png">'
		_result_text = REPLACE(_result_text, _found[0], _html)
	}

	// スタンプの前後で段落を分ける
	_paragraph = IARRAY
	for _i = 0 ; _i < 100 ; _i++ {
		if !RE_SEARCH(_result_text, '^(.*?)(<img class="stamp".*?>)') {
			// 該当が無い場合脱出
			if _result_text != '' {
				// 何かがあるので段落にする
				_paragraph ,= _result_text
			}
			break
		}
		_found = RE_GETSTR()
		if _found[1] != '' {
			// 何かがあるので段落にする
			_paragraph ,= _found[1]
		}
		_paragraph ,= _found[2]
		_result_text = SUBSTR(_result_text, STRLEN(_found[0]), STRLEN(_result_text))
	}

	_paragraph
}

//----------------------------------------------------------------
// 拡張記法の:image:からhtmlのimgタグを返す（ズームが必要ならaタグで囲む）
// 引数：　:image:の文字列、ゴースト名
// 返値：　htmlタグの文字列
// 画像のパスは、CopyImage が画像を保存したフォルダ（GhostNameToFolderName）にする
// ※1.0.5までは加工前のゴースト名をフォルダ名に使っていたので、画像が表示されなかった
//   （保存済みの履歴は BugFix_20260930_ImagePath で直す）
//----------------------------------------------------------------
GenerateHtmlImgTag
{
	_s = RE_REPLACE(_argv[0], '^:', '')
	_s = RE_REPLACE(_s, ':$', '')
	_tag = SPLIT(_s, ':')
	_sender = _argv[1]
	_html = ''
	_alt = ''

	// ファイルパス
	_filename = RE_REPLACE(_tag[1], '^nozoom=', '')
	_split = SPLIT(_filename, '\')
	_filename = _split[ARRAYSIZE(_split) - 1]
	_filepath = './res/image/' + GhostNameToFolderName(_sender) + '/' + _filename

	if STRSTR(_tag[2], 'alt=', 0) == 0 {
		// altが必要
		_alt += RE_REPLACE(_tag[2], '^alt=', '')
	}

	if STRSTR(_tag[1], 'nozoom=', 0) != 0 {
		// aタグが必要
		_html += '<a href="' + _filepath + '" class="fuwaimg"'
		if _alt != '' {
			_html += ' data-fcaption="' + _alt + '"'
		}
		_html += '>'
		// imgタグ
		_html += '<img src="' + _filepath + '"'
		if _alt != '' {
			_html += ' alt="' + _alt + '"'
		}
		_html += '>'
		_html += '</a>'
	}
	else {
		// スタンプ扱い
		_html += '<img class="stamp"'
		if _alt != '' {
			_html += ' alt="' + _alt + '"'
		}
		_html += ' src="' + _filepath + '">'
	}

	_html
}

//----------------------------------------------------------------
// 通知用スクリプトを生成する
// ここでは改行と画像altテキストをやる　TransformTextExpandの内容と重複しない
// 引数：　テキスト
// 返値：　差し替え後のスクリプトの部品　--text=文章文章,--text=文章文章
//----------------------------------------------------------------
GenerateTrayBalloonScript
{
	_result_text = SPLIT(_argv[0], ':nl:')
	_n0 = ARRAYSIZE(_result_text)

	for _i0 = 0 ; _i0 < _n0 ; _i0++ {
		_curt = _result_text[_i0]
		for _i1 = 0 ; _i1 < 100 ; _i1++ {
			// 代替テキスト無しの画像添付を探す
			if !RE_SEARCH(_curt, ':image:([^:]+?\.\w+):(?!alt=.*:)') {
				break
			}
			_found = RE_GETSTR()
			_str = RE_REPLACE(_found[1], '^nozoom=', '')
			_split = SPLIT(_str, '\')
			_filename = _split[ARRAYSIZE(_split) - 1]
			_curt = REPLACE(_curt, _found[0], ':添付:' + _filename + ':')
		}
		for _i1 = 0 ; _i1 < 100 ; _i1++ {
			// 代替テキスト付きの画像添付を探す
			if !RE_SEARCH(_curt, ':image:([^:]+?\.\w+):alt=([^:]*?):') {
				break
			}
			_found = RE_GETSTR()
			if _found[2] != '' {
				_curt = REPLACE(_curt, _found[0], ':' + _found[2] + ':')
			}
			else {
				_curt = REPLACE(_curt, _found[0], '')
			}
		}
		for _i1 = 0 ; _i1 < 100 ; _i1++ {
			// 内蔵スタンプを探す
			if !RE_SEARCH(_curt, ':stamp(\d+):') {
				break
			}
			_found = RE_GETSTR()
			_alttxt = StampAltText()[TOINT(_found[1])]
			_curt = REPLACE(_curt, _found[0], ':' + _alttxt + ':')
		}

		_result_text[_i0] = _curt
	}

	_script = ''
	for _i = 0 ; _i < _n0 ; _i++ {
		_script += ',--text='
		_script += RE_REPLACE(_result_text[_i], '[\\,\]"]', '_')
	}
	_script
}

