//================================================================
// バグ修正用（1.x系の dict/bugfix.azr を移植）
// SSPで動き始めたとき（OnSystemHostStart.UGM）に呼ぶ
//================================================================

BugFix_General
{
	BugFix_20250612_1
	BugFix_20260930_ImagePath
}

//----------------------------------------------------------------
// 2026年9月の修正（2.0.0）
// 受信履歴の本文に添付した画像のパスが、加工前のゴースト名のフォルダ
// （./res/image/ゴースト名/）になっていて表示されなかったのを、画像を保存した
// フォルダ（./res/image/GhostNameToFolderNameの名前/）に書き換える
//----------------------------------------------------------------
BugFix_20260930_ImagePath
{
	// 修正を実行した記録があれば何もしない
	if HASH_EXIST('20260930_ImagePath', bugfix_record) {
		return
	}
	foreach HASH_KEYS(SaveData_Received) ; _ghost {
		if GETTYPE(SaveData_Received[_ghost]) != 5 {
			continue
		}
		_old = './res/image/' + _ghost + '/'
		_new = './res/image/' + GhostNameToFolderName(_ghost) + '/'
		foreach HASH_KEYS(SaveData_Received[_ghost]) ; _chara {
			_msgs = SaveData_Received[_ghost][_chara]['msgs']
			if GETTYPE(_msgs) != 5 {
				continue
			}
			foreach HASH_KEYS(_msgs) ; _msg_id {
				_n = ARRAYSIZE(_msgs[_msg_id])
				for _i = 0 ; _i < _n ; _i++ {
					_texts = _msgs[_msg_id][_i]['Text']
					_changed = 0
					_new_texts = IARRAY
					foreach _texts ; _t {
						if STRSTR(_t, _old, 0) >= 0 {
							_t = REPLACE(_t, _old, _new)
							_changed = 1
						}
						_new_texts ,= _t
					}
					if _changed {
						SaveData_Received[_ghost][_chara]['msgs'][_msg_id][_i]['Text'] = _new_texts
					}
				}
			}
		}
	}
	// 修正を実行した記録を残す
	bugfix_record['20260930_ImagePath'] = 1
}

//----------------------------------------------------------------
// 2025年6月の修正
// 既存データを名指しで修正する
// 対象：「UkagakaGhostMessengerナビゲーターうめちゃん」「Love Ra.bit」
// ※1.0.5 までに実行済みなら bugfix_record に記録があるので、何もしない
// ※1.x系はフォルダをコピーしてから元を消していたが、YAYAにはフォルダごとの
//   コピーと削除が無いので、フォルダの名前を変える
//----------------------------------------------------------------
BugFix_20250612_1
{
	// 修正を実行した記録があれば何もしない
	if HASH_EXIST('20250612_1', bugfix_record) {
		return
	}
	//----------------------------------------------------------------
	// 「Love Ra.bit」のデータがあるなら処理
	_dir_old = 'localweb\html\res\image\Love_Ra.bit'
	if UGM.Exists(_dir_old) {
		// フォルダを移動
		void FRENAME(_dir_old, 'localweb\html\res\image\' + GhostNameToFolderName('Love Ra.bit'))
	}
	// 予約を修正
	if GETTYPE(SaveData_Reserved['Love_Ra.bit']) == 5 && HASH_SIZE(SaveData_Reserved['Love_Ra.bit']) > 0 {
		SaveData_Reserved['Love Ra.bit'] = SaveData_Reserved['Love_Ra.bit']
		SaveData_Reserved = UGM.HashRemove(SaveData_Reserved, 'Love_Ra.bit')
	}
	// 受信済みを修正
	if GETTYPE(SaveData_Received['Love_Ra.bit']) == 5 && HASH_SIZE(SaveData_Received['Love_Ra.bit']) > 0 {
		SaveData_Received['Love Ra.bit'] = SaveData_Received['Love_Ra.bit']
		SaveData_Received = UGM.HashRemove(SaveData_Received, 'Love_Ra.bit')
	}
	// SaveData_Waitingを修正
	_n = ARRAYSIZE(SaveData_Waiting)
	for _i = 0 ; _i < _n ; _i++ {
		if SaveData_Waiting[_i]['sender'] == 'Love_Ra.bit' {
			SaveData_Waiting[_i]['sender'] = 'Love Ra.bit'
		}
	}
	//----------------------------------------------------------------
	// 「UkagakaGhostMessengerナビゲーターうめちゃん」のデータがあるなら処理
	_dir_old = 'localweb\html\res\image\UkagakaGhostMessengerナビゲーターうめちゃん'
	if UGM.Exists(_dir_old) {
		// フォルダを移動する
		void FRENAME(_dir_old, 'localweb\html\res\image\' + GhostNameToFolderName('UkagakaGhostMessengerナビゲーターうめちゃん'))
	}
	//----------------------------------------------------------------
	// 修正を実行した記録を残す
	bugfix_record['20250612_1'] = 1
}
