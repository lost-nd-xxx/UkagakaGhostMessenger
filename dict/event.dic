//================================================================
// SSPなどから来るイベント（1.x系の dict/event.azr を移植）
// 関数の引数はリクエストのハッシュ（dict/system/yaya_plugin2.dic を参照）
//================================================================

//----------------------------------------------------------------
// OnSecondChange
//----------------------------------------------------------------
OnSecondChange
{
	_now = GetEpochSec()
	if _now > (Fake_DataLimit_LastTime + 60) {
		// Fake_DataLimit_Countのカウントをゼロに戻す
		Fake_DataLimit_Count = 0
		Fake_DataLimit_LastTime = GetEpochSec()
	}

	_script = ''
	// 表示待ちを処理（毎秒実行）
	if notify_enable == 1 {
		_script += CheckWaitingList
	}

	// 条件照合はcheck_intervalごとに実行
	check_interval_count++
	if check_interval_count >= check_interval {
		check_interval_count = 0

		// 全てのメッセージ
		_msg = ListUpAllMessageArray

		if ARRAYSIZE(_msg) > 0 {
			// 条件達成か確認
			_msg = CheckMessageCondition('', _msg)
		}

		if ARRAYSIZE(_msg) > 0 {
			// 条件を満たしたメッセージがある
			AddMessageWaitingList(_msg)
		}
	}

	if _script != '' && notify_enable == 1 {
		// 喋るべきスクリプトがある
		SaveVar
		dictOptionalHeader['event'] = 'OnUkagakaGhostMessenger_RaiseNotification'
		dictOptionalHeader['marker'] = version()
		dictOptionalHeader['script_option'] = 'nobreak'
		_script
		return
	}

	''
}

//----------------------------------------------------------------
// OnTrayBalloonClick
// 通知の履歴から、クリックされたバルーンのタイトルと同じものを新しい方から探し、
// 見つかればその送信者のページを、無ければ一覧を開く
// ※1.x系は本文も比べるつもりだったが、本文の取り出しが常に空になっていたため、
//   実際にはタイトルだけで照合していた。移植でも同じにしている
//----------------------------------------------------------------
OnTrayBalloonClick
{
	_r0 = TOSTR(_argv[0]['Reference0'])

	// ログの新しい方から探す
	_result = -1
	for _cnt = ARRAYSIZE(notify_log) - 1 ; _cnt >= 0 ; _cnt-- {
		_title = ''
		if RE_SEARCH(notify_log[_cnt]['script'], 'title=([^,\]]*)') {
			_title = RE_GETSTR()[1]
		}
		if _r0 == _title {
			_result = _cnt
			break
		}
	}

	// スクリプトを作る（ブラウザを開く）
	_output = '\C\![open,browser,http://localhost:' + localhost_number
	if _result == -1 {
		_output += '/]'
	}
	else {
		_output += '/person.html?sender='
		_output += STRENCODE(notify_log[_result]['sender'], 'UTF-8', 'url')
		_output += '&sender_id='
		_output += STRENCODE(notify_log[_result]['SenderId'], 'UTF-8', 'url')
		_output += ']'
	}
	// 結果を送信
	dictOptionalHeader['event'] = 'OnUkagakaGhostMessenger_TrayBalloonClick'
	dictOptionalHeader['marker'] = version()
	dictOptionalHeader['script_option'] = 'nobreak'
	_output
}

//----------------------------------------------------------------
// OnMenuExec
// 一覧を開く
//----------------------------------------------------------------
OnMenuExec
{
	// 結果を送信
	dictOptionalHeader['marker'] = version()
	dictOptionalHeader['script_option'] = 'nobreak'
	'\C\![open,browser,http://localhost:' + localhost_number + '/]'
}

//----------------------------------------------------------------
// ゴーストが起動した
// Reference1＝起動したゴースト名。条件 Ghost_Booted の値（ゴースト名）と、
// 両方に TranslateSystemChar を通して比べる（「Love Ra.bit」も「Love_Ra.bit」も一致する。
// Ghost_IsBooting などと同じ比べ方）
// ※1.0.5までは起動したゴースト名にだけ通していたので、記号を含む名前は、条件に
//   加工後の形（Love_Ra.bit）で書いたときだけ一致していた
//----------------------------------------------------------------
OnGhostBoot
{
	// 起動したゴースト名
	_ghostname = TOSTR(_argv[0]['Reference1'])

	// Ghost_Bootedを満たしたメッセージ
	_msg = UGM.PickUpByGhostName('Ghost_Booted', _ghostname)

	if ARRAYSIZE(_msg) > 0 {
		// Ghost_Booted以外の条件を満たしているか調べる
		_msg = CheckMessageCondition('Ghost_Booted', _msg)
	}

	if ARRAYSIZE(_msg) > 0 {
		// 条件を満たしたメッセージがある
		AddMessageWaitingList(_msg)
	}
}

//----------------------------------------------------------------
// ゴーストが終了した
// ※名前の扱いは OnGhostBoot と同じ（条件 Ghost_Closed と比べる）
//----------------------------------------------------------------
OnGhostExit
{
	// 終了したゴースト名
	_ghostname = TOSTR(_argv[0]['Reference1'])

	// Ghost_Closedを満たしたメッセージ
	_msg = UGM.PickUpByGhostName('Ghost_Closed', _ghostname)

	if ARRAYSIZE(_msg) > 0 {
		// Ghost_Closed以外の条件を満たしているか調べる
		_msg = CheckMessageCondition('Ghost_Closed', _msg)
	}

	if ARRAYSIZE(_msg) > 0 {
		// 条件を満たしたメッセージがある
		AddMessageWaitingList(_msg)
	}
}

//----------------------------------------------------------------
// 条件の値がゴースト名1つだけで、そのゴースト名が指定した名前と一致する予約を取り出す
// 名前は両方に TranslateSystemChar を通して比べる
// 引数：　条件の種類名, ゴースト名
// 返値：　メッセージ単体のハッシュの配列
// （1.x系の PickUpMessageByCondition と同じく、値が1行1つのときだけ一致とする）
//----------------------------------------------------------------
UGM.PickUpByGhostName
{
	_cond = _argv[0]
	_name = TranslateSystemChar(_argv[1])
	_result = IARRAY
	foreach HASH_KEYS(SaveData_Reserved) ; _ghost {
		if GETTYPE(SaveData_Reserved[_ghost]) != 5 {
			continue
		}
		foreach HASH_KEYS(SaveData_Reserved[_ghost]) ; _chara {
			if GETTYPE(SaveData_Reserved[_ghost][_chara]) != 5 {
				continue
			}
			foreach HASH_KEYS(SaveData_Reserved[_ghost][_chara]) ; _msg {
				_rows = SaveData_Reserved[_ghost][_chara][_msg]['Condition'][_cond]
				if ARRAYSIZE(_rows) != 1 {
					continue
				}
				_row = _rows[0]
				if ARRAYSIZE(_row) != 1 {
					continue
				}
				if TranslateSystemChar(TOSTR(_row[0])) == _name {
					_result ,= IHASH('sender', _ghost, 'SenderId', _chara, 'MessageId', _msg)
				}
			}
		}
	}
	_result
}

//----------------------------------------------------------------
// インストール済みゴースト名のリストを保存する
// Charset、ID、Language、開始行（head）以外のヘッダの値を、バイト値1で区切って並べる
// ※1.x系はヘッダの値をそのまま（バイト値1で区切らずに）持っていたので、
//   一覧の中のゴースト名を見つけられなかった。移植では名前ごとに分けて持つ
//----------------------------------------------------------------
installedghostname
{
	_list = IARRAY
	foreach _argv[0] ; _key, _value {
		if ASEARCH(_key, ('Charset', 'ID', 'Language', 'head')) >= 0 {
			continue
		}
		foreach SPLIT(TOSTR(_value), CHR(1)) ; _name {
			if _name != '' {
				_list ,= _name
			}
		}
	}
	InstalledGhostNameList = _list
}
